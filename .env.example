# Copy to .env and load it however your host loads environment variables. Never commit the real values.

# production (default) refuses to start without LEXBHARAT_SECRET. dev is for local use only.
LEXBHARAT_ENV=production

# Signs login tokens. 32+ characters. Generate with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# Changing it signs everyone out.
LEXBHARAT_SECRET=

# Only set to 1 when behind a reverse proxy that OVERWRITES X-Forwarded-For (otherwise attackers can fake their IP)
TRUST_PROXY=0

# Session lifetimes
TOKEN_TTL_MINUTES=480
REFRESH_GRACE_DAYS=7
SESSION_MAX_DAYS=30

# Data, model and limits
CORPUS_DIR=/path/to/open-india-law
NYRA_MODEL=qwen2.5:7b
OLLAMA_URL=http://127.0.0.1:11434
NYRA_MAX_CONCURRENT=2

# Translation model (needs: ollama pull gemma3:12b)
#TRANSLATE_MODEL=gemma3:12b
